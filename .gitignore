# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Env
.env
# ...and every sidecar of it. `.env` alone let `.env.bak-...` stage cleanly
# on 2026-11-03; a pre-commit secret scan caught it, which is not a control
# to rely on twice. `.env.example` is tracked and must stay keyless.
.env.*
!.env.example
.venv/
venv/

# Testing
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Editor
.DS_Store
.idea/
.vscode/

# Output (generated, not committed — fill placeholders after eval run)
out/

# Runtime data
data/atlas.db

# Fetched corpora — regenerate with `make fetch-corpus`. Third-party docs,
# reproducible from the manifest, and not ours to vendor into the repo.
data/corpus/*/


# Scratch
planning/archive/atlas-summary-2026-07.html

# Console (Vite) — built output is committed to src/atlas/api/static
console/node_modules/
console/dist/
bm25_index.json
data/index/

# Local editor/preview config — the dev-server entry Claude Code uses for the
# browser preview. Machine-specific; shared .claude/ config stays committable.
.claude/launch.json

# Issued API keys and other local secrets. Raw keys are returned once by
# POST /keys and cannot be retrieved again, so they get written to a file —
# which must never be a committable one.
*.secret.md
